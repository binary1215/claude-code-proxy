# Domain name (used by nginx and NextAuth)
DOMAIN=api.example.com

# Admin dashboard credentials (NextAuth login)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Shared secret for Express <-> Next.js service-to-service auth
ADMIN_API_SECRET=generate-a-random-secret-here

# NextAuth JWT signing secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=generate-another-random-secret-here

# Genuine CLI inference is the default; the full Docker image includes its worker.
# For a CLI-free image, set both values to http and build that explicit target.
CLAUDE_INFERENCE_BACKEND=cli
PROXY_BUILD_TARGET=default
CLAUDE_CODE_VERSION=2.1.322
CLAUDE_CLI_SESSION_TTL_SECONDS=3600
CLAUDE_CLI_MAX_SESSIONS=8

# Upstream credentials remain in the HTTP transport; a stored DB credential wins.
UPSTREAM_AUTH_SOURCE=configured
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
# Optional official setup-token input for the CLI inference backend.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional email prefill for the login-store Compose overlay. Not a token or OTP.
CLAUDE_AUTH_EMAIL=
# Optional CLI-auth background refresh (requires UPSTREAM_AUTH_SOURCE=claude_cli).
CLAUDE_AUTH_AUTO_REFRESH=false
UPSTREAM_TIMEOUT_MS=300000

# Optional stateless Responses adapter; see docs/RESPONSES-ADAPTER.md.
# Enabling requires a separate canonical base64 32-byte random secret.
RESPONSES_ENABLED=false
RESPONSES_STATE_KEY=
RESPONSES_STATE_TTL_SECONDS=604800
RESPONSES_MAX_OUTPUT_TOKENS=8192
# Manual thinking default for older/unknown IDs; known adaptive models use their policy.
RESPONSES_THINKING_BUDGET_TOKENS=1024
# Optional pinned Codex apply_patch grammar: reject (default) or validated.
# validated checks complete output before delivery; it is not constrained decoding.
RESPONSES_APPLY_PATCH_MODE=reject

# Ollama (local embedding model)
# Default: http://ollama:11434 (Docker service name)
# For local dev without Docker: http://localhost:11434
OLLAMA_URL=http://ollama:11434
