# Domain name (used by nginx and NextAuth)
DOMAIN=api.example.com

# Admin dashboard credentials (NextAuth login)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Shared secret for Express <-> Next.js service-to-service auth
ADMIN_API_SECRET=generate-a-random-secret-here

# NextAuth JWT signing secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=generate-another-random-secret-here

# Native upstream configuration. Use one credential; a stored DB credential wins.
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
# Optional setup-token input; native upstream acceptance is not guaranteed.
CLAUDE_CODE_OAUTH_TOKEN=
UPSTREAM_TIMEOUT_MS=300000

# Optional stateless Responses adapter; see docs/RESPONSES-ADAPTER.md.
# Enabling requires a separate canonical base64 32-byte random secret.
RESPONSES_ENABLED=false
RESPONSES_STATE_KEY=
RESPONSES_STATE_TTL_SECONDS=604800
RESPONSES_MAX_OUTPUT_TOKENS=8192
RESPONSES_THINKING_BUDGET_TOKENS=1024
# Optional pinned Codex apply_patch grammar: reject (default) or validated.
# validated checks complete output before delivery; it is not constrained decoding.
RESPONSES_APPLY_PATCH_MODE=reject

# Ollama (local embedding model)
# Default: http://ollama:11434 (Docker service name)
# For local dev without Docker: http://localhost:11434
OLLAMA_URL=http://ollama:11434
