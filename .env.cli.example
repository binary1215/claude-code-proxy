# Copy to a private, gitignored env file and supply real values there.
# This example uses a separate existing backend explicitly configured for HTTP.
# The CLI backend may also use direct provider credentials via compose.adapter.yml.
CLAUDE_INFERENCE_BACKEND=cli
PROXY_BUILD_TARGET=default
CLAUDE_RELAY_URL=http://192.168.0.64:13458
CLAUDE_RELAY_API_KEY=replace-with-existing-http-relay-key
ADMIN_API_SECRET=replace-with-a-private-admin-secret
RESPONSES_STATE_KEY=replace-with-canonical-base64-of-32-random-bytes
CLAUDE_CODE_VERSION=2.1.322
CLAUDE_CLI_BIND_ADDRESS=0.0.0.0
CLAUDE_CLI_PORT=13459
CLAUDE_CLI_SESSION_TTL_SECONDS=3600
CLAUDE_CLI_MAX_SESSIONS=8
RESPONSES_DEVELOPER_MESSAGE_MODE=reject
RESPONSES_APPLY_PATCH_MODE=reject
