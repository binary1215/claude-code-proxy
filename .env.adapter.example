# Copy to a private .env file. Keep real secrets out of Git and build logs.
PROXY_BIND_IP=
PROXY_PORT=13456
ADMIN_API_SECRET=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
# Optional setup-token input; configuring it does not establish native API eligibility.
CLAUDE_CODE_OAUTH_TOKEN=
UPSTREAM_TIMEOUT_MS=300000
# Optional new stateless Responses adapter. Native Messages is unchanged.
# Generate a separate 32-byte random base64 key; preserve it across restarts.
RESPONSES_ENABLED=false
RESPONSES_STATE_KEY=
RESPONSES_STATE_TTL_SECONDS=604800
RESPONSES_MAX_OUTPUT_TOKENS=8192
# 0 disables default thinking; otherwise >=1024 and below max output tokens.
RESPONSES_THINKING_BUDGET_TOKENS=1024
# Experimental, explicit relocation policy; see docs/RESPONSES-ADAPTER.md.
# Changing reject/hoist invalidates existing Responses reasoning capsules.
RESPONSES_DEVELOPER_MESSAGE_MODE=reject
