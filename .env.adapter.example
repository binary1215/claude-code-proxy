# Copy to a private .env file. Keep real secrets out of Git and build logs.
PROXY_BIND_IP=
PROXY_PORT=13456
ADMIN_API_SECRET=
CLAUDE_INFERENCE_BACKEND=cli
PROXY_BUILD_TARGET=default
CLAUDE_CODE_VERSION=2.1.322
CLAUDE_CLI_SESSION_TTL_SECONDS=3600
CLAUDE_CLI_MAX_SESSIONS=8
# Explicit HTTP/slim opt-in: set backend=http and build target=http together.
UPSTREAM_AUTH_SOURCE=configured
CLAUDE_AUTH_AUTO_REFRESH=false
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
# Optional official setup-token input; the default backend runs genuine CLI inference.
CLAUDE_CODE_OAUTH_TOKEN=
UPSTREAM_TIMEOUT_MS=300000
# Optional Responses protocol. CLI inference owns its live conversation state.
# Explicit HTTP inference retains the stateless adapter contract.
# Generate a separate 32-byte random base64 key; preserve it across restarts.
RESPONSES_ENABLED=false
RESPONSES_STATE_KEY=
RESPONSES_STATE_TTL_SECONDS=604800
RESPONSES_MAX_OUTPUT_TOKENS=8192
# Manual defaults only: 0 disables manual thinking; otherwise >=1024 and below max output.
# Known adaptive models use model-specific defaults; see docs/MODEL-COMPATIBILITY.md.
RESPONSES_THINKING_BUDGET_TOKENS=1024
# Experimental, explicit relocation policy; see docs/RESPONSES-ADAPTER.md.
# Changing reject/hoist invalidates existing Responses reasoning capsules.
RESPONSES_DEVELOPER_MESSAGE_MODE=reject
