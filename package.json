{
  "name": "claude-cli-as-api",
  "version": "1.0.0",
  "description": "Native Anthropic Messages HTTP relay for a separate LiteLLM gateway",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test tests/*.test.mjs",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "postinstall": "npm rebuild better-sqlite3"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
