#!/bin/sh
set -eu

# Interactive operator command only. The HTTP server never starts this helper.
case "${1:-status}" in
  login|logout|status|refresh) action=${1:-status} ;;
  *) echo 'Usage: claude-auth [login|status|logout|refresh]' >&2; exit 2 ;;
esac
if [ "$#" -gt 1 ]; then
  echo 'Use CLAUDE_AUTH_EMAIL for the optional login email.' >&2
  exit 2
fi
: "${CLAUDE_CONFIG_DIR:?Set CLAUDE_CONFIG_DIR to a persistent writable directory}"
umask 077
mkdir -p "$CLAUDE_CONFIG_DIR"
cd "$CLAUDE_CONFIG_DIR"

if [ "$action" = status ]; then
  exec node /app/dist/cliAuthStatus.js
fi

# Login belongs to the official service, independent of relay overrides.
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_BASE_URL
unset CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY
unset CLAUDE_CODE_OAUTH_TOKEN_FILE_DESCRIPTOR CLAUDE_CODE_API_KEY_FILE_DESCRIPTOR
export DISABLE_AUTOUPDATER=1
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
if [ "$action" = refresh ]; then
  exec flock -n -E 75 "$CLAUDE_CONFIG_DIR/.proxy-auth.lock" node /app/dist/authCommand.js refresh
fi
exec flock -w 120 -E 75 "$CLAUDE_CONFIG_DIR/.proxy-auth.lock" node /app/dist/authCommand.js "$action"
